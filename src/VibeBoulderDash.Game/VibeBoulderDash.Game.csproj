<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
<ItemGroup>
    <ProjectReference Include="..\VibeBoulderDash.Core\VibeBoulderDash.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <MajorVersion>1</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <BuildNumberFile>$(MSBuildProjectDirectory)\buildnumber.txt</BuildNumberFile>
  </PropertyGroup>
  <Target Name="BumpBuildNumber" BeforeTargets="PrepareForBuild">
    <ReadLinesFromFile File="$(BuildNumberFile)">
      <Output TaskParameter="Lines" PropertyName="StoredBuildNumber" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <BuildNumber>$(StoredBuildNumber)</BuildNumber>
      <Version>$(MajorVersion).$(MinorVersion).$(BuildNumber)</Version>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$([MSBuild]::Add($(BuildNumber), 1))" Overwrite="true" />
  </Target>
</Project>